        "policy": {
          "anonymous": true,
          "allowRepeat": false
        },
        "questions": [
          {
            "questionId": "q1",
            "type": "SINGLE",
            "title": "是否参加活动",
            "required": true,
            "options": [
              {
                "optionId": "yes",
                "label": "参加"
              },
              {
                "optionId": "no",
                "label": "不参加"
              }
            ],
            "validation": {},
            "jumpRules": [
              {
                "ruleId": "r1",
                "priority": 10,
                "operator": "EQ",
                "value": "no",
                "target": "END"
