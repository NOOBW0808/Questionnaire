              "minValue": {
                "$numberDecimal": "0"
              },
              "maxValue": {
                "$numberDecimal": "120"
              },
              "integerOnly": true
            },
            "jumpRules": []
          },
          {
            "questionId": "q3",
            "type": "MULTIPLE",
            "title": "喜欢的水果",
            "required": false,
            "options": [
              {
                "optionId": "apple",
                "label": "苹果"
              },
              {
                "optionId": "banana",
                "label": "香蕉"
              },
              {
                "optionId": "grape",
                "label": "葡萄"
              }
            ],
            "validation": {
              "minSelections": 1,
              "maxSelections": 2
            },
            "jumpRules": []
